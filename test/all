#!/bin/bash

# Everything that runs without an image build: shell syntax, the unit tests, and the deploy/ library
# tests. The image smoke tests (images/*/hack/) need a built image and run in CI's image-e2e job.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

status=0

echo "==> bash -n on every shell script"
while IFS= read -r file; do
  bash -n "$file" || { echo "syntax error: $file" >&2; status=1; }
done < <("$ROOT/test/shell-files")

echo "==> test/unit"
"$ROOT/test/unit" || status=1

echo "==> deploy/tests"
for t in "$ROOT"/deploy/tests/*.test.sh; do
  printf -- '--> %s\n' "${t#"$ROOT"/}"
  bash "$t" || status=1
done

if (( status == 0 )); then
  echo
  echo "test/all: PASS"
else
  echo
  echo "test/all: FAIL" >&2
fi
exit "$status"
