# On-hardware boot-test overlay on top of a built Fenoa image. It adds a gated unit that runs
# boot-smoke.sh at boot and reports over the console and journal — nothing test-related lands in a
# published image.
#
#   podman build -t fenoa:44-boottest --build-arg BASE=fenoa:44 -f images/boottest/Containerfile .
#
# Install the -boottest image on a PC or a UEFI VM (bootc install to-disk, or bootc switch) and read
# the verdict from `journalctl -u fenoa-boottest`: "BOOT SMOKE: PASS".
ARG BASE=fenoa:44
FROM ${BASE}

COPY images/boottest/boot-smoke.sh /usr/libexec/fenoa-boot-smoke
COPY images/boottest/fenoa-boottest.service /usr/lib/systemd/system/fenoa-boottest.service
COPY images/boottest/fenoa-boottest.preset /usr/lib/systemd/system-preset/50-fenoa-boottest.preset
RUN chmod +x /usr/libexec/fenoa-boot-smoke \
 && systemctl enable fenoa-boottest.service \
 && bootc container lint
