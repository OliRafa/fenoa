# Fenoa — Fedora Noctalia Atomic (Fedora · x86_64 PCs)
#
# Two stages, built in order:
#
#   platform  Fedora base-atomic + everything a PC needs to run as a bootc OS: systemd-boot, a
#             composefs-capable initramfs, first-boot user creation, Flatpak/Homebrew provisioning,
#             system tuning. No desktop. Built and smoke-tested in CI (`--target platform`), never
#             published on its own.
#   desktop   FROM platform: Hyprland + Noctalia shell + noctalia-greeter (greetd). This is the
#             published `fenoa` image (fenoa:44-amd64, in the multi-arch fenoa:44).
#
# Two helper stages only supply files: `brew` (Universal Blue's prebuilt Homebrew tree, for platform)
# and `librepods` (builds the AirPods plugin's daemon, for desktop).
#
# Apple Silicon is the asahi branch's stream, built on Fedora Asahi Remix; this file targets x86_64
# only (see images/build.sh):
#   ./images/build.sh platform     # -> fenoa-platform:44 (local only)
#   ./images/build.sh fenoa        # -> fenoa:44

ARG BASE=quay.io/fedora-ostree-desktops/base-atomic
ARG FEDORA=44

# Homebrew comes from Universal Blue's brew image — the same one Bluefin and Bazzite consume. It is
# a `FROM scratch` context image holding only /system_files: a prebuilt, zstd-compressed Homebrew
# tree at /usr/share/homebrew.tar.zst plus the units and shell hooks that manage it. Built for both
# amd64 and arm64; the build pulls the one for its own architecture.
#
# Taking the prebuilt tree rather than running Homebrew's installer at first boot is the point:
# every brew failure seen on this platform was a first-boot network failure, and one was invisible
# because `bash -c "$(curl ...)"` exits 0 when the curl fails.
#
# NOTE: this is a third-party image baked into the OS — a real trust dependency. Pin BREW_IMAGE to a
# digest if that tradeoff ever needs tightening.
ARG BREW_IMAGE=ghcr.io/ublue-os/brew:latest
FROM ${BREW_IMAGE} AS brew

# ==================================================================================================
# librepods — build-only stage for the AirPods plugin's daemon; the desktop stage copies its output
# ==================================================================================================
# The AirPods plugin (harveywuk/airpods) drives a patched librepods (GPL-3.0): upstream
# kavishdevar/librepods lacks the status file and control verbs it reads. No distribution packages
# the fork, so it is built here from a pinned commit; git checks that the tree is that commit. Bump
# LIBREPODS_COMMIT deliberately, after reading the diff: the daemon runs in every user's session with
# Bluetooth access. Built on the same base and Fedora repos as the desktop stage, so it links the
# Qt the image carries. /usr/share/licenses/librepods/SOURCE names the source of the GPL binary.
FROM ${BASE}:${FEDORA} AS librepods
ARG LIBREPODS_REPO=https://github.com/harveywuk/librepods
ARG LIBREPODS_COMMIT=4ed49df0b301ac3e6fba9c81dfbbb6726cc52201
RUN retry() { n=1; while ! "$@"; do [ "$n" -ge 5 ] && return 1; echo "[dnf-retry] attempt $n failed: $*"; dnf clean all || true; sleep $((n*5)); n=$((n+1)); done; }; \
    retry dnf -y install git-core cmake ninja-build gcc-c++ pkgconf-pkg-config qt6-qtbase-devel \
      qt6-qtdeclarative-devel qt6-qtconnectivity-devel qt6-qttools-devel openssl-devel pulseaudio-libs-devel
RUN set -eux; \
    git init -q /src; \
    git -C /src fetch -q --depth 1 "$LIBREPODS_REPO" "$LIBREPODS_COMMIT"; \
    git -C /src checkout -q FETCH_HEAD; \
    [ "$(git -C /src rev-parse HEAD)" = "$LIBREPODS_COMMIT" ]; \
    cmake -S /src -B /build -G Ninja -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr; \
    cmake --build /build; \
    DESTDIR=/out cmake --install /build; \
    install -Dm0644 /src/LICENSE /out/usr/share/licenses/librepods/LICENSE; \
    printf 'Built from %s at commit %s\n' "$LIBREPODS_REPO" "$LIBREPODS_COMMIT" >/out/usr/share/licenses/librepods/SOURCE

# ==================================================================================================
# platform
# ==================================================================================================
FROM ${BASE}:${FEDORA} AS platform

# P1) Platform packages. The base already carries the kernel, linux-firmware (GPU, Wi-Fi, Bluetooth
#     and audio firmware, split by vendor), CPU microcode, fwupd, Mesa and dracut;
#     packages/platform.packages adds the system services. Inline comments and blank lines are
#     stripped. Fedora mirrors flake often enough on CI to retry (clean metadata + linear backoff)
#     before giving up.
COPY packages/platform.packages /tmp/platform.packages
RUN retry() { n=1; while ! "$@"; do [ "$n" -ge 5 ] && return 1; echo "[dnf-retry] attempt $n failed: $*"; dnf clean all || true; sleep $((n*5)); n=$((n+1)); done; }; \
    retry dnf -y install $(sed 's/#.*//' /tmp/platform.packages | awk 'NF') \
 && dnf clean all \
 && rm -f /tmp/platform.packages

# P2) Drop the browser inherited from the base. base-atomic ships Firefox; Fenoa's browser is the
#     Brave Flatpak (desktop stage manifest), so a native Firefox is dead weight and a second,
#     unthemed browser. Best-effort: if a dependency ever holds it, log and continue.
RUN { dnf -y remove firefox firefox-langpacks 2>/dev/null || true; } \
 && for p in firefox firefox-langpacks; do \
      rpm -q "$p" >/dev/null 2>&1 && echo "[P2] KEPT (held by a dependency): $p" || echo "[P2] removed: $p"; \
    done \
 && dnf clean all

# P3) Bootloader: systemd-boot; drop GRUB, shim, bootupd and rpm-ostree.
#     - bootc installs systemd-boot when told to (`--bootloader systemd`, the install docs/platform.md
#       describes). bootupd manages GRUB/shim only, never systemd-boot, so it and the GRUB and shim
#       payloads it installs from have no job here.
#     - rpm-ostree is package layering; the composefs backend uses composefs-rs, not rpm-ostree.
#     Fedora marks GRUB and shim as protected (/etc/dnf/protected.d), so dnf refuses to remove them
#     unless that list is cleared for the command; nothing else in the image needs them (os-prober
#     goes with grub2-tools). grub2-common's boot-success units go too: they record a boot in a
#     grubenv, and under systemd-boot they would fail on every login. The build fails if any of it
#     survives. systemd-boot-unsigned carries no Secure Boot signature, so Fenoa boots with Secure
#     Boot off (docs/platform.md).
RUN set -eux; \
    dnf -y remove --setopt=protected_packages= rpm-ostree bootupd 'grub2-*' 'shim-*'; \
    dnf clean all; \
    for p in rpm-ostree bootupd grub2-common grub2-efi-x64 grub2-tools shim-x64; do \
      if rpm -q "$p" >/dev/null 2>&1; then echo "[P3] $p is still installed"; exit 1; fi; \
    done; \
    for u in /usr/lib/systemd/user/grub-boot-success.timer /usr/lib/systemd/system/grub-boot-indeterminate.service; do \
      [ ! -e "$u" ] || { echo "[P3] $u survived the GRUB removal"; exit 1; }; \
    done

# P4) The platform overlay: first-boot/provisioning units and helpers, system tuning drop-ins, and
#     50-fenoa.preset, which lists every unit this stage enables or disables so a first boot's preset
#     pass keeps them. Copied AFTER the package install so the packages' %config files
#     (cups-browsed.conf) are replaced rather than left as .rpmnew, and BEFORE P5 so the initramfs
#     would pick up any dracut or modprobe drop-in added here.
COPY system/platform/ /
RUN chmod 0755 /usr/libexec/fenoa-* /usr/lib/systemd/system-sleep/fenoa-* \
 && chmod 0440 /etc/sudoers.d/fenoa-* \
 && visudo -cf /etc/sudoers.d/fenoa-passwd-tries

# P5) composefs boot: rebuild the initramfs with bootc's dracut module.
#     The base image's initramfs is built for the OSTREE backend: it ships ostree-prepare-root.service
#     gated on ConditionKernelCommandLine=ostree and nothing that reads `composefs=`. Install with
#     --composefs-backend against that and the boot entry carries composefs=<digest> that no
#     initramfs component consumes — the kernel mounts root= directly and you boot the IMAGE's kernel
#     against whatever /usr is already on the disk (seen on hardware: emergency mode).
#
#     bootc ships /usr/lib/dracut/modules.d/51bootc (module `bootc`) which installs
#     /usr/lib/bootc/initramfs-setup + bootc-root-setup.service. Rebuild
#     /usr/lib/modules/<kver>/initramfs.img with it — exactly what the composefs install copies to
#     <ESP>/EFI/Linux/bootc_composefs-<digest>/initrd. dracut includes neither it nor ostree's module
#     unless named (both checks return 255), so name both: the ostree module keeps the ostree backend
#     booting, for a Fedora Atomic install that `bootc switch`es to Fenoa and keeps its GRUB and
#     ostree layout. Each pivot runs only for its own command line (ostree-prepare-root with ostree=,
#     bootc-root-setup with composefs=). FAIL the build if the result lacks either unit.
#
#     DRACUT_NO_XATTR / DRACUT_NO_MKNOD: dracut sets these itself when it detects a container; that
#     detection does not fire here, and the xattr copy failures would otherwise log once per file.
#     /var/roothome: /root is a symlink to var/roothome and /var is empty in the image, so
#     dracut-install dies on the dangling link; create it for the run only, keeping /var empty for
#     `bootc container lint`.
RUN set -eux; \
    export DRACUT_NO_XATTR=1 DRACUT_NO_MKNOD=1; \
    kver="$(basename "$(dirname "$(find /usr/lib/modules -maxdepth 2 -name vmlinuz | head -1)")")"; \
    moddir="$(ls -d /usr/lib/dracut/modules.d/*bootc 2>/dev/null | head -1)"; \
    [ -n "$moddir" ] || { echo "[P5] no bootc dracut module — composefs installs cannot pivot"; exit 1; }; \
    modname="$(basename "$moddir" | sed 's/^[0-9]*//')"; \
    echo "[P5] rebuilding initramfs for $kver with dracut module '$modname' ($moddir)"; \
    if [ -e /var/roothome ]; then roothome_made=0; else mkdir -p /var/roothome; roothome_made=1; fi; \
    dracut --force --no-hostonly --reproducible --kver "$kver" \
      --add "$modname ostree" "/usr/lib/modules/$kver/initramfs.img"; \
    if [ "$roothome_made" = 1 ]; then rmdir /var/roothome; fi; \
    { set +x; } 2>/dev/null; \
    contents="$(lsinitrd "/usr/lib/modules/$kver/initramfs.img")"; \
    for u in bootc-root-setup ostree-prepare-root; do \
      echo "$contents" | grep -q "$u\.service" || { echo "[P5] rebuilt initramfs lacks $u.service"; exit 1; }; \
    done; \
    echo "[P5] initramfs carries the composefs and ostree root setup"

# P6) First-boot user provisioning. The image ships no human user and a composefs
#     `to-existing-root` convert does NOT import the underlying OS's user, so the greeter would have
#     no account to offer. fenoa-firstboot-user creates the primary user once (preseed via
#     /etc/fenoa/firstboot-user.conf, else an interactive tty1 prompt), ordered before the display
#     manager. Before it, systemd-firstboot asks on tty1 for the locale, the keymap and the
#     timezone. That one is a static unit (sysinit.target wants it) that runs only on a first boot,
#     which the "uninitialized" /etc/machine-id written in P9 makes systemd detect, so there is
#     nothing to enable. It asks for no root password: the image's /etc/shadow already has a root
#     entry ("*", locked), which it treats as configured; the user created next is in wheel.
RUN set -eux; \
    systemctl enable fenoa-firstboot-user.service

# P7) Homebrew + Flatpak first-boot provisioning. Neither can live in /usr as a working install:
#     Homebrew needs a writable prefix owned by a human user, and Flatpaks live in /var/lib/flatpak,
#     which bootc only seeds on first boot.
#
#     Homebrew is only UNPACKED at first boot: ublue's brew-setup.service extracts
#     /usr/share/homebrew.tar.zst into /home/linuxbrew, and brew-update.timer / brew-upgrade.timer
#     keep it current afterwards. fenoa-brew-setup.service re-owns the prefix to the real primary
#     user and applies /usr/share/fenoa/Brewfile.
#
#     Flatpaks use Fedora/flatpak's upstream `flatpak preinstall` (manifests under
#     /usr/share/flatpak/preinstall.d — the desktop stage ships the app set). The Flathub remote is
#     baked in as a LOCAL file so registering it at first boot downloads nothing; the build fails
#     rather than ship an image whose remote step is back on the network.
#     flatpak-add-fedora-repos.service is masked: it would add Fedora's remotes (including
#     fedora-testing), and Flathub, which the preinstall unit puts first, carries every app the set
#     names.
#
#     The Brewfile and the Flatpak app set install from TIMERS, not from multi-user.target.
#     NetworkManager-wait-online is masked (P8), so a boot-time start runs before Wi-Fi is up: `brew
#     bundle` fails, and offline `flatpak preinstall` exits 0 having installed nothing.
#     fenoa-flatpak-preinstall.timer and fenoa-brew-setup.timer start their service 30s after boot
#     and again every 2 minutes while its fenoa-online condition skips it (the hosts it needs do not
#     answer over HTTPS yet). A failed preinstall is retried by its timer; a failed `brew bundle`
#     backs off instead (Restart= in the unit). The services have no [Install] section of their own.
COPY --from=brew /system_files/ /
COPY Brewfile /usr/share/fenoa/Brewfile
RUN set -eux; \
    [ -s /usr/share/homebrew.tar.zst ] || { echo "[P7] brew image shipped no homebrew.tar.zst"; exit 1; }; \
    command -v flatpak >/dev/null || { echo "[P7] flatpak (for the preinstall CLI) not installed"; exit 1; }; \
    mkdir -p /etc/flatpak/remotes.d; \
    curl --retry 3 --retry-delay 2 -fL -o /etc/flatpak/remotes.d/flathub.flatpakrepo \
      https://dl.flathub.org/repo/flathub.flatpakrepo; \
    [ -s /etc/flatpak/remotes.d/flathub.flatpakrepo ] || { echo "[P7] failed to bake flathub.flatpakrepo"; exit 1; }; \
    systemctl mask flatpak-add-fedora-repos.service; \
    systemctl enable fenoa-flatpak-preinstall.timer fenoa-flatpak-update.timer fenoa-brew-setup.timer; \
    systemctl enable brew-setup.service brew-update.timer brew-upgrade.timer

# P8) System services. Nothing in the session needs to block on the network, so mask
#     NetworkManager-wait-online and let network-online.target pass without waiting for DHCP/Wi-Fi
#     association; the units that need the network wait for it themselves instead (fenoa-online
#     conditions, retried from timers; P7). systemd-oomd's [Install] pulls in systemd-oomd.socket,
#     which the user manager reports app.slice candidacy over.
#
#     SSH is opt-in. Fedora presets sshd enabled and its default firewalld zone allows ssh, so a
#     laptop would accept password logins from the network out of the box. Disable the unit
#     (/usr/lib/systemd/system-preset/50-fenoa.preset keeps a preset pass from re-enabling it) and
#     drop ssh from the default zone. Both halves tolerate a base image that no longer has them:
#     sshd is disabled only if its unit ships, and the zone is queried before ssh is removed; then
#     assert the zone no longer allows it.
RUN set -eux; \
    systemctl enable NetworkManager.service bluetooth.service firewalld.service \
      systemd-resolved.service avahi-daemon.service power-profiles-daemon.service \
      cups.service cups-browsed.service docker.socket systemd-oomd.service fstrim.timer; \
    systemctl mask NetworkManager-wait-online.service; \
    if [ -f /usr/lib/systemd/system/sshd.service ]; then systemctl disable sshd.service; fi; \
    zone="$(firewall-offline-cmd --get-default-zone)"; \
    if firewall-offline-cmd --zone="$zone" --query-service=ssh; then \
      firewall-offline-cmd --zone="$zone" --remove-service-from-zone=ssh; \
    fi; \
    if firewall-offline-cmd --zone="$zone" --query-service=ssh; then \
      echo "[P8] ssh is still allowed in the $zone zone"; exit 1; \
    fi

# P9) Ship /etc/machine-id as "uninitialized", then clear build residue and lint.
#
#      machine-id(5): systemd treats a boot as the first one when /etc/machine-id is absent or reads
#      "uninitialized"; the base image's EMPTY file does not count, and then systemd-firstboot (P6)
#      never runs. bootc copies the image's /etc into a new install as is, so with this file the
#      first boot of every install is detected: systemd-firstboot asks its questions, a full preset
#      pass runs (50-fenoa.preset keeps every unit as built), and systemd then writes the real ID
#      to /etc/machine-id. An upgrade keeps that ID: it differs from what the old image shipped, so
#      bootc's /etc three-way merge treats it as a local change. Written in this last step so that
#      nothing an earlier step ran (a package scriptlet, say) can leave a real ID baked into the
#      image; systemd-machine-id-setup itself leaves "uninitialized" alone. D6 repeats it after the
#      desktop packages.
#
#      Build residue: the stage must be bootc-clean (no content in /run, /tmp, /var/log or dnf
#      caches — these trip the nonempty-run-tmp / var-log / var-tmpfiles lints). Target specific
#      residue dirs, not /run/* wholesale: the build engine bind-mounts
#      /run/systemd/resolve/stub-resolv.conf for build DNS, which cannot be removed.
RUN printf 'uninitialized\n' >/etc/machine-id \
 && [ "$(cat /etc/machine-id)" = uninitialized ] \
 && rm -rf /var/cache/dnf /var/cache/libdnf5 /var/lib/dnf/repos /var/lib/dnf/history* \
 && rm -f /var/log/dnf5.log* /var/log/dnf.log* /var/log/hawkey.log* \
 && rm -rf /run/dnf /tmp/* \
 && bootc container lint

# ==================================================================================================
# desktop — published as `fenoa`
# ==================================================================================================
FROM platform AS desktop

# D1) Repositories.
#     - lionheartp/Hyprland COPR: the Hyprland stack with the 0.55+ Lua config this image uses
#       (built for x86_64 and aarch64). priority=10 makes it win over Fedora for the Hyprland
#       packages. It also carries GTK/Pango/Cairo builds and -git builds of Noctalia, the greeter and
#       Quickshell: excluded, so GTK stays Fedora's and noctalia/noctalia-greeter can only come from
#       Fedora/Terra (dnf would otherwise satisfy `noctalia-greeter` with the COPR's
#       noctalia-greeter-git).
#     - Terra: noctalia-greeter, which Fedora does not package (noctalia itself is in Fedora).
#       terra-release is bootstrapped without a signature check, as Terra documents; it installs the
#       repo's signing key, so everything installed from it afterwards is verified (dnf5 imports the
#       key for repomd checks only when allowed to, hence the explicit `makecache -y`). A dnf5 repo
#       override restricts Terra to noctalia-greeter, so it can never replace a Fedora package.
#     Both are set through /etc/dnf/repos.override.d rather than by editing the shipped .repo files.
RUN set -eux; \
    dnf -y copr enable lionheartp/Hyprland; \
    dnf -y install --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release; \
    mkdir -p /etc/dnf/repos.override.d; \
    printf '%s\n' '[copr:copr.fedorainfracloud.org:lionheartp:Hyprland]' 'priority=10' \
      'excludepkgs=gtk4* gtk3* pango* cairo* noctalia* quickshell*' \
      >/etc/dnf/repos.override.d/90-fenoa-hyprland.repo; \
    printf '%s\n' '[terra]' 'includepkgs=noctalia-greeter' >/etc/dnf/repos.override.d/90-fenoa-terra.repo; \
    dnf -y makecache --repo terra; \
    dnf repoquery -q --repo terra --qf '%{name}\n' noctalia-greeter | grep -qx noctalia-greeter \
      || { echo "[D1] Terra does not offer noctalia-greeter"; exit 1; }; \
    dnf clean all

# D2) Hyprland and its uwsm session file (hyprland-uwsm.desktop — the session the greeter starts).
#     Prefer stable; fall back to -git when a soname bump leaves stable unresolvable. The COPR's
#     mirrors flake often enough to retry each attempt before giving up.
RUN retry() { n=1; while ! "$@"; do [ "$n" -ge 5 ] && return 1; echo "[dnf-retry] attempt $n failed: $*"; dnf clean all || true; sleep $((n*5)); n=$((n+1)); done; }; \
    { retry dnf -y install hyprland hyprland-uwsm || retry dnf -y install hyprland-git hyprland-git-uwsm; } \
 && dnf clean all

# D3) Desktop packages: Noctalia, noctalia-greeter + greetd, portals, fonts, theming, a lean app set.
COPY packages/desktop.packages /tmp/desktop.packages
RUN retry() { n=1; while ! "$@"; do [ "$n" -ge 5 ] && return 1; echo "[dnf-retry] attempt $n failed: $*"; dnf clean all || true; sleep $((n*5)); n=$((n+1)); done; }; \
    retry dnf -y install $(sed 's/#.*//' /tmp/desktop.packages | awk 'NF') \
 && dnf clean all \
 && rm -f /tmp/desktop.packages

# D3b) The ai-usagebar CLI, which the AI Usage bar widget (Noctalia plugin felipeartur/ai-usagebar,
#      enabled in /usr/share/fenoa/noctalia/fenoa.toml) runs as `ai-usagebar usage --json`. The CLI is
#      a separate project (akitaonrails/ai-usagebar) in neither Fedora nor Homebrew, so it comes from
#      its GitHub release: the latest one at build time, resolved once so all three files come from
#      the same release, because Noctalia keeps the plugin itself updated and the weekly rebuild keeps
#      the CLI in step with it. The signing key is fetched from that release, so trust rests on the
#      pinned fingerprint (also published on keys.openpgp.org): the build fails unless the tarball
#      carries a good signature from that key. gpgv needs a binary keyring; GNUPGHOME keeps gpg off
#      /root, a dangling link during the build (see P5).
ARG AI_USAGEBAR_KEY=AE42EF5D73DD92E248815C95B65CCCAF64A99438
RUN set -eux; \
    releases=https://github.com/akitaonrails/ai-usagebar/releases; \
    latest="$(curl --retry 3 --retry-delay 2 -fsSLI -o /dev/null -w '%{url_effective}' "$releases/latest")"; \
    tag="${latest##*/}"; \
    case "$tag" in v[0-9]*) ;; *) echo "[D3b] no release tag in $latest"; exit 1 ;; esac; \
    url="$releases/download/$tag"; \
    tarball="ai-usagebar-linux-$(uname -m).tar.gz"; \
    tmp="$(mktemp -d)"; \
    for f in "$tarball" "$tarball.sig" ai-usagebar-signing-key.asc; do \
      curl --retry 3 --retry-delay 2 -fsSL -o "$tmp/$f" "$url/$f"; \
    done; \
    GNUPGHOME="$tmp" gpg --batch --dearmor -o "$tmp/key.gpg" "$tmp/ai-usagebar-signing-key.asc"; \
    status="$(gpgv --status-fd 1 --keyring "$tmp/key.gpg" "$tmp/$tarball.sig" "$tmp/$tarball")"; \
    echo "$status" | grep -qE "^\[GNUPG:\] VALIDSIG .* $AI_USAGEBAR_KEY\$" \
      || { echo "[D3b] $tarball is not signed by $AI_USAGEBAR_KEY"; exit 1; }; \
    tar -xzf "$tmp/$tarball" -C "$tmp" ./ai-usagebar ./LICENSE; \
    install -Dm0755 "$tmp/ai-usagebar" /usr/bin/ai-usagebar; \
    install -Dm0644 "$tmp/LICENSE" /usr/share/licenses/ai-usagebar/LICENSE; \
    rm -rf "$tmp"; \
    ai-usagebar --version

# D3c) The librepods daemon and librepods-ctl for the AirPods plugin (harveywuk/airpods), from the
#      librepods build stage. The daemon runs headless as a user service bound to the graphical
#      session (upstream's sandboxed unit, pointed at /usr/bin; the widget stays hidden until AirPods
#      connect), and the plugin finds librepods-ctl on PATH. Its .desktop entry is left out: it starts
#      the tray GUI, which with the daemon running only pings it and exits. The Qt it links is listed
#      in desktop.packages; the build fails if either binary is missing a library.
#      50-fenoa-desktop.preset under user-preset keeps the unit enabled through a preset pass.
COPY --from=librepods /out/usr/bin/librepods /out/usr/bin/librepods-ctl /usr/bin/
COPY --from=librepods /out/usr/share/openpods/ /usr/share/openpods/
COPY --from=librepods /out/usr/share/licenses/librepods/ /usr/share/licenses/librepods/
COPY --from=librepods /out/usr/share/systemd/user/librepods.service /usr/lib/systemd/user/librepods.service
RUN set -eux; \
    unit=/usr/lib/systemd/user/librepods.service; \
    sed -i 's|^ExecStart=%h/\.local/bin/librepods |ExecStart=/usr/bin/librepods |' "$unit"; \
    grep -qx 'ExecStart=/usr/bin/librepods --headless' "$unit" \
      || { echo "[D3c] librepods.service does not run /usr/bin/librepods --headless"; exit 1; }; \
    for b in librepods librepods-ctl; do \
      missing="$(ldd "/usr/bin/$b" | grep 'not found' || true)"; \
      [ -z "$missing" ] || { echo "[D3c] $b is missing libraries: $missing"; exit 1; }; \
    done; \
    systemctl --global enable librepods.service

# D4) The desktop overlay: Hyprland defaults (/usr/share/fenoa/hypr) and Noctalia defaults
#     (/usr/share/fenoa/noctalia) that the thin user configs in /etc/skel pull in; greetd + greeter
#     config, its state-directory tmpfiles entry and SELinux label; the greeter-sync polkit rule; session
#     environment, portal routing, default terminal and default apps; the Flatpak app set; the
#     webapp launchers (Brave app windows) and their icons; the keyboard-backlight and lid helpers;
#     and 50-fenoa-desktop.preset, which keeps greetd and graphical.target through a first boot's
#     preset pass.
#     Copied after the packages so /etc/greetd/config.toml replaces the package's agreety default.
#     The hicolor icon cache was built by the package scriptlets before the webapp icons arrived, and
#     GTK trusts it as long as the theme's top directory is no newer than it, which adding a file to
#     scalable/apps does not change: rebuild it, or GTK apps never find those icons.
COPY system/desktop/ /
RUN set -eux; \
    chmod 0755 /usr/bin/fenoa-kbd-backlight /usr/bin/fenoa-hypr-clamshell /usr/libexec/fenoa-greeter-session; \
    gtk-update-icon-cache -f /usr/share/icons/hicolor; \
    getent passwd greetd >/dev/null || { echo "[D4] greetd's greeter account is missing"; exit 1; }; \
    [ -x /usr/bin/noctalia-greeter-session ] || { echo "[D4] noctalia-greeter-session missing"; exit 1; }; \
    [ -x /usr/bin/lua ] || { echo "[D4] lua missing: fenoa-greeter-session cannot give the greeter the session's layout"; exit 1; }; \
    [ -x /usr/bin/noctalia-greeter-apply-appearance ] || { echo "[D4] greeter sync helper missing"; exit 1; }; \
    grep -qx 'Name=Hyprland (uwsm-managed)' /usr/share/wayland-sessions/hyprland-uwsm.desktop \
      || { echo "[D4] the greeter's default session name no longer matches hyprland-uwsm.desktop"; exit 1; }; \
    semodule -i /usr/share/fenoa/selinux/fenoa-greeter.cil; \
    grep -qE '^/var/lib/noctalia-greeter\(/\.\*\)\?[[:space:]]+system_u:object_r:xdm_var_lib_t:s0$' \
      /etc/selinux/targeted/contexts/files/file_contexts \
      || { echo "[D4] the greeter state directory is not labelled xdm_var_lib_t"; exit 1; }

# D5) Boot to the greeter. greetd aliases display-manager.service, which fenoa-firstboot-user is
#     ordered before, so the first account exists by the time the greeter lists users.
RUN set -eux; \
    systemctl enable greetd.service; \
    systemctl set-default graphical.target

# D5b) Open LocalSend's port (TCP+UDP 53317, /usr/lib/firewalld/services/localsend.xml) in the default
#      firewalld zone; the base image's "public" zone allows neither discovery nor transfers.
RUN set -eux; \
    zone="$(firewall-offline-cmd --get-default-zone)"; \
    firewall-offline-cmd --zone="$zone" --add-service=localsend; \
    firewall-offline-cmd --zone="$zone" --query-service=localsend

# D6) Ship /etc/machine-id as "uninitialized" again (see P9), in case anything D3 installed wrote an
#     ID; clear build residue and lint.
RUN printf 'uninitialized\n' >/etc/machine-id \
 && [ "$(cat /etc/machine-id)" = uninitialized ] \
 && rm -rf /var/cache/dnf /var/cache/libdnf5 /var/lib/dnf/repos /var/lib/dnf/history* \
 && rm -f /var/log/dnf5.log* /var/log/dnf.log* /var/log/hawkey.log* \
 && rm -rf /run/dnf /tmp/* \
 && bootc container lint
