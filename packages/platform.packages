# Fenoa platform layer — Fedora system packages layered onto quay.io/fedora-ostree-desktops/base-atomic
# (x86_64). The base already carries the kernel, linux-firmware (GPU, Wi-Fi, Bluetooth and audio
# firmware, split by vendor), CPU microcode, fwupd, Mesa and dracut; this list adds what a bootc
# laptop OS needs on top. No desktop here — packages/desktop.packages layers that.
#
# One package per line; text after `#` is ignored (images/fenoa/Containerfile strips it).

# --- Boot: systemd-boot replaces GRUB on this image (see images/fenoa/Containerfile step P3) ---
systemd-boot-unsigned

# --- Graphics (AMD and Intel; Fedora's Mesa also carries AMD's VA-API driver). base-atomic ships
# both; listed so they stay should the base drop them ---
mesa-vulkan-drivers         # RADV (AMD) and ANV (Intel) Vulkan
libva-intel-media-driver    # VA-API video decode and encode for Intel (Broadwell and later)

# --- Networking ---
NetworkManager
NetworkManager-tui
wpa_supplicant              # NM's Wi-Fi backend on Fedora; iwd is not used
wireless-regdb
firewalld
avahi
nss-mdns

# --- Bluetooth ---
bluez

# --- Audio (PipeWire; laptop DSP firmware such as Intel SOF comes with the base) ---
pipewire-pulseaudio
pipewire-alsa
wireplumber
pulseaudio-utils
alsa-utils
rtkit

# --- Power ---
power-profiles-daemon
upower
brightnessctl               # keyboard backlight (fenoa-kbd-backlight); the shell drives the panel itself
zram-generator
bolt

# --- Printing (driverless/IPP Everywhere; see /etc/cups/cups-browsed.conf) ---
cups
cups-browsed
cups-filters
cups-pk-helper              # PolicyKit-authenticated printer administration

# --- Storage ---
btrfs-progs
dosfstools
exfatprogs

# --- Containers ---
moby-engine
docker-compose
docker-buildx

# --- Provisioning (first-boot Flatpak preinstall; Homebrew ships prebuilt from ublue's image) ---
flatpak
curl                        # fenoa-online's HTTPS check; base-atomic ships it, listed so it stays
dbus-tools                  # dbus-run-session: the Flatpak units need a session bus (see the units)
dbus-daemon                 # ...which dbus-run-session starts; base-atomic ships neither

# --- Console and base CLI ---
plymouth
terminus-fonts-console
sudo
less
man-db
zsh                         # new accounts' login shell (fenoa-firstboot-user), Fedora's stock config
vim-minimal                 # provides `vi` for $EDITOR fallbacks
unzip
wget2-wget
util-linux-script
plocate
git
jq
python3-pip
inotify-tools
socat
