[Unit]
Description=Preinstall the Fenoa Flatpak app set (Flathub, plus Fedora for what Flathub lacks)
Documentation=man:flatpak-preinstall(1)
# Runs Fedora/flatpak's upstream `flatpak preinstall`, which reads /usr/share/flatpak/preinstall.d
# and installs the vendor app set — the install logic, idempotency and user opt-out are all upstream.
# This is bluefin-common's flatpak-preinstall.service, adapted: Fedora packages the CLI but no boot
# unit, and it differs from bluefin where our platform differs (see below).
#
# No [Install] section: fenoa-flatpak-preinstall.timer starts this, never a boot target
# (DIVERGENCE 1). No Condition*= either, not even bluefin's ConditionPathExists=/usr/bin/flatpak
# (the build fails without flatpak anyway): a unit skipped by a condition is inactive, and the timer
# would start it again every 2 minutes for the rest of the boot.
#
# No Before=flatpak-system-helper.service, unlike bluefin: flatpak reads /etc/flatpak/remotes.d by
# itself, and with that ordering a `flatpak install` the user starts during a long preinstall waits
# for the whole run to finish before the helper starts, and fails on the D-Bus timeout.

[Service]
Type=oneshot
# A run that succeeds stays active, which is what stops the timer from starting it again this boot.
RemainAfterExit=yes
# DIVERGENCE 1: wait for the network with a condition and a timer, not network-online.target.
# bluefin orders this after network-online.target and retries with Restart=on-failure. Neither works
# here: the image masks NetworkManager-wait-online (images/fenoa/Containerfile), so
# network-online.target is reached before Wi-Fi has associated — on a fresh install Wi-Fi is not
# even configured until the user sets it up in the session — and offline `flatpak preinstall` skips
# every ref it cannot reach, prints "Nothing to do." and EXITS 0. Restart=on-failure never fired,
# RemainAfterExit kept the unit "active", and the app set silently never installed. Instead:
#  - fenoa-online skips the run (inactive, not failed) until both remotes answer over HTTPS with a
#    valid certificate (resolving the names is not enough: a captive portal resolves them too);
#  - the timer starts a skipped or failed run again 2 minutes after it ended (OnUnitInactiveSec=):
#    with --noninteractive, an install or download error aborts preinstall with exit 1, so a pull
#    that breaks off is retried 2 minutes later;
#  - a run that exits 0 stays active (RemainAfterExit=yes), so the timer has nothing left to do.
# One case still waits for the next boot: a remote that passes the HTTPS check but whose index then
# cannot be fetched. preinstall skips its refs as if offline, prints "Nothing to do." and exits 0.
ExecCondition=/usr/libexec/fenoa-online dl.flathub.org registry.fedoraproject.org
# DIVERGENCE 2: add the remotes here rather than bluefin's build-time `flatpak remote-add`. A
# build-time system remote writes to /var/lib/flatpak, and our composefs-native image ships a FRESH
# /var seeded only on first boot, so it would not survive to here. Flathub comes from the local file
# baked by images/fenoa/Containerfile and needs no download; adding Fedora's OCI remote fetches
# nothing either.
#
# Two remotes, Flathub first. `flatpak preinstall` installs each app from the first remote, in
# priority order, that has it for this architecture, and breaks ties alphabetically — so with equal
# priorities "fedora" would beat "flathub" for every app both carry (LibreOffice, Loupe, Evince...).
# Flathub gets priority 10 and Fedora 1, so Fedora only supplies what Flathub lacks on aarch64: OBS
# Studio. remote-modify re-asserts the priorities on machines whose remotes already existed.
ExecStartPre=/usr/bin/flatpak remote-add --system --if-not-exists flathub /etc/flatpak/remotes.d/flathub.flatpakrepo
ExecStartPre=/usr/bin/flatpak remote-add --system --if-not-exists --title="Fedora Flatpaks" fedora oci+https://registry.fedoraproject.org
ExecStartPre=/usr/bin/flatpak remote-modify --system --prio=10 flathub
ExecStartPre=/usr/bin/flatpak remote-modify --system --prio=1 fedora
# Wrap in dbus-run-session: `flatpak preinstall` needs a D-Bus SESSION bus (it activates the OCI
# authenticator), and a system service has none — without one it dies instantly with "Cannot
# autolaunch D-Bus without X11 $DISPLAY" and installs nothing. dbus-run-session gives it a throwaway
# session bus; flatpak still reaches the privileged install helper over the system bus as normal.
# (remote-add/remote-modify above need no session bus, so they are left unwrapped.)
# No stamp and run on every boot on purpose: `flatpak preinstall` is a fast no-op once satisfied, it
# applies later additions to the app set, and it honours apps the user has since removed.
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/flatpak preinstall -y --noninteractive
