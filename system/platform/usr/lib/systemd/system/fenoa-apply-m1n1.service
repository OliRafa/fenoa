[Unit]
Description=Apply m1n1 + devicetree from the atomic image to the boot partition (Asahi)
Documentation=https://github.com/fedora-asahi-remix-atomic-desktops/images/issues/2
# /boot and /usr must be present; ordered late so it never blocks the boot it runs in.
After=local-fs.target
# Only when this boot came through m1n1: it records the ESP it booted from (the partition's UUID)
# in the devicetree, and that is how update-m1n1 finds the ESP. update-m1n1 itself ships in every
# Fenoa image, so its presence says nothing about the machine.
ConditionPathExists=/proc/device-tree/chosen/asahi,efi-system-partition

[Service]
Type=oneshot
RemainAfterExit=yes
# Optional: create /etc/default/fenoa-m1n1 with FENOA_M1N1_AUTOREBOOT=1 to auto-reboot
# once when a new devicetree is staged.
EnvironmentFile=-/etc/default/fenoa-m1n1
ExecStart=/usr/libexec/fenoa-apply-m1n1

[Install]
WantedBy=multi-user.target
