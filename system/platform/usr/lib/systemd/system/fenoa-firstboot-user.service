[Unit]
Description=Fenoa first-boot primary user provisioning
Documentation=man:bootc(8)
# Gate on OUR marker, not systemd's ConditionFirstBoot.
#
# ConditionFirstBoot holds only on the boot that finds /etc/machine-id absent or "uninitialized"; an
# empty file is not a first boot, which is why a ConditionFirstBoot gate once silently skipped on
# hardware, leaving getty on tty1 and a greeter with no account to offer — a dead end with no way
# in. The image now ships "uninitialized", so the first boot is detected, but systemd commits a
# real machine ID during that boot: after an aborted prompt or a failed useradd the next boot is no
# longer a first boot, and a ConditionFirstBoot gate would never retry.
#
# A new install starts with the image's empty /var, so a marker there means "this install has not
# been provisioned yet", and the helper writes it only once a human user actually exists — an
# aborted prompt or a failed useradd therefore retries on the next boot rather than latching off.
ConditionPathExists=!/var/lib/fenoa/firstboot-user.done
# systemd-firstboot asks for the locale, keymap and timezone first (no root password: the image's
# root entry counts as configured); then, if /etc/vconsole.conf carries a console KEYMAP with no
# XKB settings, we add the XKB layout known for it (so the greeter and the session use it too) and
# add the human user. Must finish BEFORE the greeter (greetd aliases display-manager.service) so it
# has an account to offer.
After=systemd-firstboot.service systemd-user-sessions.service
Wants=systemd-firstboot.service
Before=display-manager.service
# The interactive fallback needs tty1, so take it from getty for the duration.
After=getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Optional per-machine preseed (KEY=VALUE); absent ⇒ interactive prompt on tty1.
ExecStart=/usr/libexec/fenoa-firstboot-user
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
