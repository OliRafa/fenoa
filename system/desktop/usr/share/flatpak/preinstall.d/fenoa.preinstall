# Fenoa — GUI apps delivered as Flatpaks on first boot.
#
# A Fedora/flatpak-native "preinstall" manifest (see flatpak-preinstall(1)): on every boot,
# fenoa-flatpak-preinstall.service runs `flatpak preinstall -y` once the remotes answer over HTTPS
# (its timer tries 30s after boot, then every 2 minutes) and installs the groups below. The upstream
# CLI owns the install logic, the idempotency and the opt-out: an app the user uninstalls is
# remembered and not reinstalled. Apps pin Branch=stable because that is Flathub's branch (the
# flatpak default, "master", does not exist there and an unpinned group silently installs nothing);
# the GTK3 theme extensions at the end have their own branch, 3.22.
#
# Each app comes from Flathub, which fenoa-flatpak-preinstall.service adds at priority 10, so it
# wins over any remote the machine already had (a Fedora Atomic switched to Fenoa has Fedora's). A
# ref no remote has is skipped silently, not retried.
#
# Kept deliberately lean; install anything else with `flatpak install flathub <app>`.

# Browser. It fetches the Widevine DRM module (Spotify, Netflix) itself when DRM is first needed.
[Flatpak Preinstall com.brave.Browser]
Branch=stable
IsRuntime=false

# Password manager. Its unlock polkit action ships in the image (/usr/share/polkit-1/actions), and
# fenoa-bitwarden-browsers.service connects it to the Bitwarden extension in Brave and Firefox, which
# Bitwarden cannot do itself from its sandbox (/usr/libexec/fenoa-bitwarden-browsers).
[Flatpak Preinstall com.bitwarden.desktop]
Branch=stable
IsRuntime=false

# Image viewer.
[Flatpak Preinstall org.gnome.Loupe]
Branch=stable
IsRuntime=false

# PDF viewer.
[Flatpak Preinstall org.gnome.Evince]
Branch=stable
IsRuntime=false

# Office suite.
[Flatpak Preinstall org.libreoffice.LibreOffice]
Branch=stable
IsRuntime=false

# Notes.
[Flatpak Preinstall md.obsidian.Obsidian]
Branch=stable
IsRuntime=false

# Send files to nearby devices. Needs TCP+UDP 53317, which the image opens in firewalld
# (/usr/lib/firewalld/services/localsend.xml).
[Flatpak Preinstall org.localsend.localsend_app]
Branch=stable
IsRuntime=false

# Screen recording and streaming.
[Flatpak Preinstall com.obsproject.Studio]
Branch=stable
IsRuntime=false

# Light/dark for GTK3 and Qt apps inside the sandbox. On every light/dark switch Noctalia's gtk
# template sets the color-scheme setting and the GTK theme (adw-gtk3 or adw-gtk3-dark), and the
# settings portal hands both to Flatpak apps. GTK4/libadwaita, Firefox, Chromium and Electron follow
# color-scheme on their own, but GTK3 ignores it and can only load a theme its runtime carries:
# without these it falls back to light Adwaita in dark mode. Qt apps go the same way, through the
# runtime's libqgtk3 (the session exports QT_QPA_PLATFORMTHEME=gtk3, and Flatpak passes it in).
#
# These are the theme extensions for runtimes on org.freedesktop, org.gnome and org.kde (Flathub's).
# Nothing else installs them: flatpak's own auto-download fetches only the GTK theme active for the
# user running it, and the preinstall and the daily update run as root, whose theme is plain
# Adwaita. Both are listed because Noctalia switches between the two, and the one not yet used must
# already be there when it does.
[Flatpak Preinstall org.gtk.Gtk3theme.adw-gtk3]
Branch=3.22
IsRuntime=true

[Flatpak Preinstall org.gtk.Gtk3theme.adw-gtk3-dark]
Branch=3.22
IsRuntime=true
