# Fenoa — GUI apps delivered as Flatpaks on first boot.
#
# A Fedora/flatpak-native "preinstall" manifest (see flatpak-preinstall(1)): fenoa-flatpak-preinstall
# runs `flatpak preinstall -y` at startup and installs the groups below. The upstream CLI owns the
# install logic, the idempotency and the opt-out: an app the user uninstalls is remembered and not
# reinstalled. Branch=stable because that is Flathub's branch (the flatpak default, "master", does
# not exist there and an unpinned group silently installs nothing).
#
# Each app comes from the first remote, by priority, that has it for aarch64: Flathub (priority 10),
# then Fedora's Flatpak registry (priority 1) — set up by fenoa-flatpak-preinstall.service. A ref no
# remote has is skipped silently, not retried.
#
# Kept deliberately lean; install anything else with `flatpak install flathub <app>`.

# Browser. Run `fenoa-widevine` after its first start to enable DRM (Spotify, Netflix) on aarch64.
[Flatpak Preinstall com.brave.Browser]
Branch=stable
IsRuntime=false

# Image viewer.
[Flatpak Preinstall org.gnome.Loupe]
Branch=stable
IsRuntime=false

# PDF viewer.
[Flatpak Preinstall org.gnome.Evince]
Branch=stable
IsRuntime=false

# Office suite.
[Flatpak Preinstall org.libreoffice.LibreOffice]
Branch=stable
IsRuntime=false

# Notes.
[Flatpak Preinstall md.obsidian.Obsidian]
Branch=stable
IsRuntime=false

# Send files to nearby devices. Needs TCP+UDP 53317, which the image opens in firewalld
# (/usr/lib/firewalld/services/localsend.xml).
[Flatpak Preinstall org.localsend.localsend_app]
Branch=stable
IsRuntime=false

# Screen recording and streaming. Flathub builds OBS for x86_64 only, so on Apple Silicon this
# resolves to Fedora's Flatpak (fedora remote, org.fedoraproject.KDE6Platform runtime).
[Flatpak Preinstall com.obsproject.Studio]
Branch=stable
IsRuntime=false
